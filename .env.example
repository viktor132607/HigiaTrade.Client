# Local backend
NEXT_PUBLIC_API_URL=http://localhost:10000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEO / search-engine verification
# Paste only the verification token, not the whole meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional: override the deterministic IndexNow key/end point.
# INDEXNOW_KEY=
# INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# Regional SEO pages are generated only for categories with enough real products.
SEO_MIN_REGIONAL_CATEGORY_PRODUCTS=4
SEO_MAX_REGIONAL_CATEGORIES=6

# Render backend
# NEXT_PUBLIC_API_URL=https://higiatrade-server.onrender.com/api
# NEXT_PUBLIC_SITE_URL=https://higiatrade.com